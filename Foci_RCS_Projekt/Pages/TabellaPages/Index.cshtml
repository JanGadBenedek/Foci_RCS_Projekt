@page
@model Foci_RCS_Projekt.Pages.TabellaPages.IndexModel

@{
    ViewData["Title"] = "Bajnoki tabella";
}

<h1>Bajnoki tabella</h1>


<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Hely</th>
                <th>Csapat</th>
                <th title="Lejátszott mérkőzések">M</th>
                <th title="Győzelmek">GY</th>
                <th title="Döntetlenek">D</th>
                <th title="Vereségek">V</th>
                <th title="Rúgott gólok">RG</th>
                <th title="Kapott gólok">KG</th>
                <th title="Gólkülönbség">GK</th>
                <th>Pont</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Tabella.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        Még nincs felvett csapat.
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < Model.Tabella.Count; i++)
                {
                    var sor = Model.Tabella[i];

                    string sorSzin = "";

                    if (i == 0)
                    {
                        sorSzin = "arany-hely";
                    }
                    else if (i == 1)
                    {
                        sorSzin = "ezust-hely";
                    }
                    else if (i == 2)
                    {
                        sorSzin = "bronz-hely";
                    }
                    else if (i == Model.Tabella.Count - 1 && Model.Tabella.Count >= 4)
                    {
                        sorSzin = "kieso-hely";
                    }

                    <tr class="@sorSzin">
                        <td class="fw-bold">
                            @if (i == 0)
                            {
                                <span>🥇 1.</span>
                            }
                            else if (i == 1)
                            {
                                <span>🥈 2.</span>
                            }
                            else if (i == 2)
                            {
                                <span>🥉 3.</span>
                            }
                            else if (i == Model.Tabella.Count - 1 && Model.Tabella.Count >= 4)
                            {
                                <span>🔻 @(i + 1).</span>
                            }
                            else
                            {
                                <span>@(i + 1).</span>
                            }
                        </td>
                        <td class="fw-semibold">
                            @sor.CsapatNev
                            @if (i == Model.Tabella.Count - 1 && Model.Tabella.Count >= 4)
                            {
                                <span class="badge bg-danger ms-1">Kiesőzóna</span>
                            }
                        </td>
                        <td>@sor.Lejatszott</td>
                        <td>@sor.Gyozelem</td>
                        <td>@sor.Dontetlen</td>
                        <td>@sor.Vereseg</td>
                        <td>@sor.RugottGol</td>
                        <td>@sor.KapottGol</td>
                        <td>
                            @(sor.GolKulonbseg > 0 ? "+" : "")@sor.GolKulonbseg
                        </td>
                        <td class="fw-bold">@sor.Pont</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-3 text-muted small">
    <p><strong>M:</strong> lejátszott mérkőzések</p>
    <p><strong>GY:</strong> győzelem · <strong>D:</strong> döntetlen · <strong>V:</strong> vereség</p>
    <p><strong>RG:</strong> rúgott gól · <strong>KG:</strong> kapott gól · <strong>GK:</strong> gólkülönbség</p>
    <p>Utolsó hely= Kiesőzóna!</p>
</div>

<style>
    .arany-hely > td {
        background-color: #ffe08a !important;
        color: #664600;
    }

    .ezust-hely > td {
        background-color: #d9dee3 !important;
        color: #343a40;
    }

    .bronz-hely > td {
        background-color: #e8b08b !important;
        color: #633b24;
    }

    .kieso-hely > td {
        background-color: #f5b7b7 !important;
        color: #842029;
    }
</style>
