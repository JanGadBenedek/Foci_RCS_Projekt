@page
@model IndexModel

@{
    ViewData["Title"] = "Kezdőlap";
}

<div class="mb-4">
    <h1>Bajnokságkezelő</h1>
</div>

<hr />

<div class="row mt-3 g-3">
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h5>Csapatok</h5>
            <p>Csapatadatok megtekintése és szerkesztése.</p>
            <a asp-page="/CsapatPages/Index" class="btn btn-outline-success">
                Csapatok megnyitása
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h5>Mérkőzések</h5>
            <p>Mérkőzések felvétele és eredmények rögzítése.</p>
            <a asp-page="/MerkozesPages/Index" class="btn btn-outline-success">
                Mérkőzések megnyitása
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h5>Bajnoki tabella</h5>
            <p>Pontszámok, gólkülönbségek és helyezések.</p>
            <a asp-page="/TabellaPages/Index" class="btn btn-outline-success">
                Tabella megnyitása
            </a>
        </div>
    </div>
</div>

