@page
@model Foci_RCS_Projekt.Pages.MerkozesPages.IndexModel

@{
    ViewData["Title"] = "Mérkőzések";
}

<h1>Mérkőzések</h1>

<p class="text-muted">
    A bajnokság mérkőzéseinek és eredményeinek nyilvántartása.
</p>

@if (TempData["Siker"] != null)
{
    <div class="alert alert-success">@TempData["Siker"]</div>
}

@if (TempData["Hiba"] != null)
{
    <div class="alert alert-danger">@TempData["Hiba"]</div>
}

<p>
    <a asp-page="./Create" class="btn btn-primary">
        + Új mérkőzés felvétele
    </a>
</p>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label for="Szuro" class="form-label">Mérkőzések szűrése</label>
        <select id="Szuro" name="Szuro" class="form-select">
            <option value="osszes" selected="@(Model.Szuro == "osszes")">
                Összes mérkőzés
            </option>
            <option value="lejatszott" selected="@(Model.Szuro == "lejatszott")">
                Lejátszott mérkőzések
            </option>
            <option value="hatralevo" selected="@(Model.Szuro == "hatralevo")">
                Hátralévő mérkőzések
            </option>
        </select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">
            Szűrés
        </button>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Összes
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Dátum</th>
                <th>Hazai csapat</th>
                <th>Eredmény</th>
                <th>Vendégcsapat</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Merkozesek.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Nincs a szűrésnek megfelelő mérkőzés.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var meccs in Model.Merkozesek)
                {
                    <tr>
                        <td>@meccs.Datum.ToString("yyyy. MM. dd.")</td>
                        <td class="fw-semibold">@meccs.HazaiCsapat.Nev</td>
                        <td>
                            @if (meccs.HazaiGol.HasValue && meccs.VendegGol.HasValue)
                            {
                                <strong>@meccs.HazaiGol – @meccs.VendegGol</strong>
                            }
                            else
                            {
                                <span class="text-muted">– : –</span>
                            }
                        </td>
                        <td class="fw-semibold">@meccs.VendegCsapat.Nev</td>
                        <td>
                            <a asp-page="./Edit"
                               asp-route-id="@meccs.Id"
                               class="btn btn-sm btn-outline-primary">
                                Eredmény / szerkesztés
                            </a>
                            <a asp-page="./Delete"
                               asp-route-id="@meccs.Id"
                               class="btn btn-sm btn-outline-danger">
                                Törlés
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="text-muted small">
    Megjelenített mérkőzések száma: @Model.Merkozesek.Count
</p>
