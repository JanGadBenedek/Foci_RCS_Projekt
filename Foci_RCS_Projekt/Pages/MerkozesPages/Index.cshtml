@page
@model Foci_RCS_Projekt.Pages.MerkozesPages.IndexModel

@{
    ViewData["Title"] = "Mérkőzések";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Mérkőzések</h1>
    </div>

    <a asp-page="./Create" class="btn btn-success">
        + Új mérkőzés
    </a>
</div>

@if (TempData["Siker"] != null)
{
    <div class="alert alert-success">@TempData["Siker"]</div>
}

@if (TempData["Hiba"] != null)
{
    <div class="alert alert-danger">@TempData["Hiba"]</div>
}

<div class="border rounded p-3 mb-4 bg-light">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="Szuro" class="form-label">Mérkőzések szűrése</label>
            <select id="Szuro" name="Szuro" class="form-select">
                <option value="osszes" selected="@(Model.Szuro == "osszes")">
                    Összes mérkőzés
                </option>
                <option value="lejatszott" selected="@(Model.Szuro == "lejatszott")">
                    Lejátszott mérkőzések
                </option>
                <option value="hatralevo" selected="@(Model.Szuro == "hatralevo")">
                    Hátralévő mérkőzések
                </option>
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-outline-success">
                Szűrés
            </button>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Alaphelyzet
            </a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Mérkőzéslista</h5>
    <span class="text-muted small">
        Találatok: @Model.Merkozesek.Count
    </span>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>Dátum</th>
                <th>Hazai csapat</th>
                <th class="text-center">Eredmény</th>
                <th>Vendégcsapat</th>
                <th class="text-end">Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Merkozesek.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Nincs a szűrésnek megfelelő mérkőzés.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var meccs in Model.Merkozesek)
                {
                    <tr>
                        <td class="text-nowrap">
                            @meccs.Datum.ToString("yyyy. MM. dd.")
                        </td>
                        <td class="fw-semibold">@meccs.HazaiCsapat.Nev</td>
                        <td class="text-center">
                            @if (meccs.HazaiGol.HasValue && meccs.VendegGol.HasValue)
                            {
                                <span class="fw-bold">
                                    @meccs.HazaiGol – @meccs.VendegGol
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">– : –</span>
                            }
                        </td>
                        <td class="fw-semibold">@meccs.VendegCsapat.Nev</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-1">
                                <a asp-page="./Edit"
                                   asp-route-id="@meccs.Id"
                                   class="btn btn-sm btn-outline-success">
                                    Eredmény / szerkesztés
                                </a>
                                <a asp-page="./Delete"
                                   asp-route-id="@meccs.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Törlés
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
