@page
@model Foci_RCS_Projekt.Pages.CsapatPages.DetailsModel

@{
    ViewData["Title"] = "Csapat részletei";
}

<h1>@Model.Csapat.Nev</h1>

<p class="text-muted">A csapat adatai és mérkőzései.</p>

<hr />

<dl class="row">
    <dt class="col-sm-3">Csapat neve</dt>
    <dd class="col-sm-9">@Model.Csapat.Nev</dd>

    <dt class="col-sm-3">Város</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Csapat.Varos)
            ? "Nincs megadva"
            : Model.Csapat.Varos)
    </dd>

    <dt class="col-sm-3">Alapítás éve</dt>
    <dd class="col-sm-9">
        @(Model.Csapat.AlapitasEve?.ToString() ?? "Nincs megadva")
    </dd>
</dl>

<div class="mt-3 mb-4">
    <a asp-page="./Edit"
       asp-route-id="@Model.Csapat.Id"
       class="btn btn-primary">
        Szerkesztés
    </a>

    <a asp-page="./Index" class="btn btn-secondary">
        Vissza a listához
    </a>
</div>

<hr />

<h2>Utolsó 5 mérkőzés formája</h2>

<p class="text-muted">
    A legutóbbi, eredménnyel rendelkező mérkőzések alapján.
</p>

@if (Model.UtolsoOtMerkozes.Count == 0)
{
    <p class="text-muted">A csapatnak még nincs lejátszott mérkőzése.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-4">
        @foreach (var meccs in Model.UtolsoOtMerkozes)
        {
            var szin = meccs.Eredmeny switch
            {
                "GY" => "success",
                "D" => "warning",
                _ => "danger"
            };

            <div class="card text-center shadow-sm" style="min-width: 130px;">
                <div class="card-body">
                    <span class="badge bg-@szin fs-6 mb-2">
                        @meccs.Eredmeny
                    </span>

                    <div class="fw-semibold">
                        @meccs.SajatGol – @meccs.EllenfelGol
                    </div>

                    <div class="small text-muted mt-1">
                        @meccs.Ellenfel
                    </div>

                    <div class="small text-muted">
                        @meccs.Datum.ToString("yyyy. MM. dd.")
                    </div>
                </div>
            </div>
        }
    </div>
}

<hr />

<h2>Mérkőzések</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Dátum</th>
                <th>Hazai csapat</th>
                <th>Eredmény</th>
                <th>Vendégcsapat</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Merkozesek.Count == 0)
            {
                <tr>
                    <td colspan="4">
                        A csapatnak még nincs mérkőzése.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var meccs in Model.Merkozesek)
                {
                    <tr>
                        <td>@meccs.Datum.ToString("yyyy. MM. dd.")</td>
                        <td>@meccs.HazaiCsapat.Nev</td>
                        <td>
                            @if (meccs.HazaiGol.HasValue &&
                                 meccs.VendegGol.HasValue)
                            {
                                <strong>@meccs.HazaiGol – @meccs.VendegGol</strong>
                            }
                            else
                            {
                                <span class="text-muted">Még nincs eredmény</span>
                            }
                        </td>
                        <td>@meccs.VendegCsapat.Nev</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
