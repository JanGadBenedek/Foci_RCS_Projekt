@page
@model Foci_RCS_Projekt.Pages.CsapatPages.IndexModel

@{
    ViewData["Title"] = "Csapatok";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Csapatok</h1>
    </div>

    <a asp-page="./Create" class="btn btn-success">
        + Új csapat
    </a>
</div>

@if (TempData["Siker"] != null)
{
    <div class="alert alert-success">@TempData["Siker"]</div>
}

@if (TempData["Hiba"] != null)
{
    <div class="alert alert-danger">@TempData["Hiba"]</div>
}

<div class="p-3 mb-4 border rounded bg-light">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-7">
            <input type="text"
                   name="Kereses"
                   value="@Model.Kereses"
                   class="form-control"
                   placeholder="Csapat neve vagy városa..." />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-outline-success">
                Keresés
            </button>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Összes
            </a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Nyilvántartott csapatok</h5>
    <span class="text-muted small">Találatok: @Model.Csapatok.Count</span>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>Csapat neve</th>
                <th>Város</th>
                <th>Alapítás éve</th>
                <th class="text-end">Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Csapatok.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Kereses))
                        {
                            <span>Nincs találat erre: „@Model.Kereses”.</span>
                        }
                        else
                        {
                            <span>Még nincs felvett csapat.</span>
                        }
                    </td>
                </tr>
            }
            else
            {
                @foreach (var csapat in Model.Csapatok)
                {
                    <tr>
                        <td class="fw-semibold">@csapat.Nev</td>
                        <td>@(string.IsNullOrWhiteSpace(csapat.Varos) ? "—" : csapat.Varos)</td>
                        <td>@(csapat.AlapitasEve?.ToString() ?? "—")</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-1">
                                <a asp-page="./Details"
                                   asp-route-id="@csapat.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Részletek
                                </a>
                                <a asp-page="./Edit"
                                   asp-route-id="@csapat.Id"
                                   class="btn btn-sm btn-outline-success">
                                    Szerkesztés
                                </a>
                                <a asp-page="./Delete"
                                   asp-route-id="@csapat.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Törlés
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
